# Every environment variable the project reads (spec 017 tech §4). Names and comments only — never commit values.
# Local development: copy to apps/web/.env.local. With MOCK_EXTERNALS=1 no accounts or keys are needed.

# --- Mode -------------------------------------------------------------------------------------------------
# 1 = serve every external service from fixtures (default). Set 0 in production.
MOCK_EXTERNALS=1
# live (default): real DNS, RDAP, Porkbun prices and FX rates even in mock mode | fixture: recorded answers (tests)
PUBLIC_DATA_MODE=live
# off = no user e-mail (owner decision 2026-10-03). Only switch on after the site has its own domain.
EMAIL_MODE=off
# email | chat — owner alert channel (spec 015 FR-OBS-012)
ALERT_CHANNEL=email
# enforce | off — 'off' only works with MOCK_EXTERNALS=1 (end-to-end tests); production always enforces limits
RATE_LIMIT_MODE=enforce

# --- Site identity (spec 000 FR-SYS-011) — the only place the name and address live ----------------------
NEXT_PUBLIC_SITE_NAME=
# e.g. https://<project>.vercel.app at launch
NEXT_PUBLIC_SITE_URL=

# --- Supabase (database + auth, region ap-south-1 / Mumbai) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server and GitHub Actions only — never in the browser
SUPABASE_SERVICE_ROLE_KEY=
# pooler connection string, GitHub Actions only (jobs, migrations, backups)
SUPABASE_DB_URL=

# --- Jev decision model (spec 002) ------------------------------------------------------------------------
# gateway (Vercel AI Gateway, default; needs a card on file) | direct (TypeSafe API) | ngrok (ngrok.ai)
JEV_ROUTE=gateway
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
NGROK_AI_API_KEY=
# pinned version, never "latest"
JEV_MODEL=jev-1.13.0

# --- Rate limits and human check (spec 014) ---------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- HMAC secrets: 32+ random characters each (e.g. `openssl rand -hex 32`) ------------------------------
SEARCH_LINK_SECRET=
VISITOR_SALT_SECRET=
UNSUBSCRIBE_SECRET=

# --- E-mail (owner alerts now; user e-mail only when EMAIL_MODE=on) ---------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
BREVO_API_KEY=

# --- Owner and admin (spec 011 §5.8, spec 015) ------------------------------------------------------------
OWNER_ALERT_EMAIL=
OWNER_USER_ID=
# comma-separated user ids allowed into /ops/saved; defaults to OWNER_USER_ID
ADMIN_USER_IDS=

# --- Price sources (spec 006) — GitHub Actions only --------------------------------------------------------
PRICE_PROVIDERS=porkbun-pricing
PREMIUM_PROVIDERS=
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
NAMECOM_API_USER=
NAMECOM_API_TOKEN=
DYNADOT_API_KEY=
DISPLAY_CURRENCIES=all

# --- Daily data (spec 010) --------------------------------------------------------------------------------
NRD_URL_TEMPLATE=

# --- Errors and analytics (spec 013, 015, 009) ------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Policies (spec 013) ----------------------------------------------------------------------------------
POLICY_VERSION=v1
# defaults: Priyansh K / priyansh1210@gmail.com (owner decision 2026-10-03)
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=

# --- Backups (spec 012 §5.4) — the public key may live in the repo; the private key stays offline ---------
BACKUP_AGE_PUBLIC_KEY=
